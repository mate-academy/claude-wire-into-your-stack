{
  "permissions": {
    "allow": [
      "mcp__docs-fs__read_text_file",
      "mcp__docs-fs__read_multiple_files",
      "mcp__docs-fs__list_directory",
      "mcp__docs-fs__directory_tree",
      "mcp__docs-fs__search_files",
      "mcp__docs-fs__get_file_info",
      "mcp__docs-fs__list_allowed_directories"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-edit-lint.js"
          }
        ]
      }
    ]
  }
}
