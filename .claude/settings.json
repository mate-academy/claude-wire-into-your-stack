{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Glob",
      "Grep"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Claude modified a file in this project.'"
          }
        ]
      }
    ]
  }
}
