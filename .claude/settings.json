{
  "permissions": {
    "allow": [
      "mcp__docs__read_text_file",
      "mcp__docs__list_directory"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-lint.js\""
          }
        ]
      }
    ]
  }
}
