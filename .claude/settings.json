{
  "permissions": {
    "allow": [
      "mcp__docs-readonly__list_docs",
      "mcp__docs-readonly__read_doc"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.js\""
          }
        ]
      }
    ]
  }
}
