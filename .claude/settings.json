{
  "permissions": {
    "deny": [
      "mcp__github__create_branch"
    ],
    "allow": [
      "mcp__github__get_me"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'if echo \"$CLAUDE_TOOL_INPUT\" | grep -q \"git push\"; then npm test; fi'"
          }
        ]
      }
    ],
    "PostToolUse": [
        {
        "matcher": "Edit",
        "hooks": [
            {
              "type": "command",
              "command": "npx prettier --write %f"
            }
        ]
    }
    ]
  }
}