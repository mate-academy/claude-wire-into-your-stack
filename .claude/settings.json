{
  "permissions": {
    "allow": [
      "mcp__project-docs__read_file",
      "mcp__project-docs__list_directory"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint --silent 2>&1 | head -30"
          }
        ]
      }
    ]
  }
}
