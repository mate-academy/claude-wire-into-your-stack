{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-npm-publish.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-on-edit.js\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(./**)",
      "mcp__docs-filesystem__read_text_file",
      "mcp__docs-filesystem__list_directory",
      "mcp__docs-filesystem__get_file_info"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Bash(git push --force:*)",
      "Bash(*rm *..*)",
      "Bash(rmdir *..*)",
      "Bash(*rm /*)",
      "Bash(*rm ~/*)",
      "Read(~/*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(curl | sh)"
    ]
  }
}
