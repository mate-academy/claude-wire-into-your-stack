
{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-destructive-guard.js",
            "statusMessage": "Checking for destructive file operations..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/pre-secret-scan.js",
            "statusMessage": "Scanning staged changes for secrets..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-lint.js",
            "statusMessage": "Linting changed file..."
          }
        ]
      }
    ]
  }
}