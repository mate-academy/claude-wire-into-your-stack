{
  "permissions": {
    "allow": ["mcp__github__issue_read"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/staged-summary.sh",
            "timeout": 15,
            "statusMessage": "Summarising staged changes..."
          }
        ]
      }
    ]
  }
}
