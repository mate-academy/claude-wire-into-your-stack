{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "mcp__fetch__fetch"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/lint-fix.js"
          }
        ]
      }
    ]
  }
}
