{
  "permissions": {
    "allow": [
      "mcp__docs__read_text_file",
      "mcp__docs__list_directory",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "mcp__docs__write_file",
      "mcp__docs__edit_file"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-publish.py\""
          }
        ]
      }
    ]
  }
}
