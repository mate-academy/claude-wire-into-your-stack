{
  "permissions": {
    "allow": [
      "mcp__docs__read_file",
      "mcp__docs__list_directory"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path // empty'); case \"$file\" in *.js) npx eslint --fix \"$file\" ;; esac"
          }
        ]
      }
    ]
  }
}
