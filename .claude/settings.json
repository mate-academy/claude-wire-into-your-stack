{
  "permissions": {
    "allow": [
      "Bash(npm test:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push --force:*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // empty' | { read -r f; case \"$f\" in *.js|*.jsx|*.mjs|*.cjs) npx eslint --fix \"$f\";; esac; } 2>/dev/null || true",
            "statusMessage": "Running eslint --fix"
          }
        ]
      }
    ]
  }
}
