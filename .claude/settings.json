{
  "enabledMcpjsonServers": ["docs"],
  "permissions": {
    "allow": [
      "mcp__docs__read_text_file",
      "mcp__docs__list_directory",
      "mcp__docs__search_files"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-force-push.js"
          }
        ]
      }
    ]
  }
}
