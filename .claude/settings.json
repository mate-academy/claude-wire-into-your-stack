{
  "permissions": {
    "allow": [
      "mcp__docs-fs__read_text_file",
      "mcp__docs-fs__list_directory",
      "mcp__docs-fs__search_files"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint --silent 1>&2 || exit 2"
          }
        ]
      }
    ]
  }
}
