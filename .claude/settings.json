{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__docs__read_text_file",
      "mcp__docs__read_multiple_files",
      "mcp__docs__list_directory",
      "mcp__docs__directory_tree",
      "mcp__docs__search_files",
      "mcp__docs__get_file_info",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)"
    ],
    "deny": [
      "mcp__docs__write_file",
      "mcp__docs__edit_file",
      "mcp__docs__move_file",
      "mcp__docs__create_directory"
    ]
  },
  "enabledMcpjsonServers": [
    "docs"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/lint-fix.js",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
