{
  "permissions": {
    "allow": ["mcp__fetch__fetch"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint",
            "statusMessage": "Running npm run lint"
          }
        ]
      }
    ]
  }
}
