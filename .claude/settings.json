{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-git-push-main.sh",
            "statusMessage": "Checking for git push to main..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__filesystem__read_text_file"
    ]
  }
}
