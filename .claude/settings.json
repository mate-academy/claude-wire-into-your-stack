{
  "permissions": {
    "allow": [
      "mcp__fetch__fetch",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-on-js-edit.sh\""
          }
        ]
      }
    ]
  }
}
