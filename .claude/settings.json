{
  "permissions": {
    "allow": [
      "mcp__docs__list_directory",
      "mcp__docs__directory_tree",
      "mcp__docs__read_file"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx eslint server.js routes db tests"
          }
        ]
      }
    ]
  }
}
