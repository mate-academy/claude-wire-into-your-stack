{
  "permissions": {
    "allow": [
      "mcp__filesystem__read_text_file"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/lint-on-edit.js\"",
            "timeout": 30,
            "statusMessage": "Linting edited file…"
          }
        ]
      }
    ]
  }
}
