{
  "enabledPlugins": {
    "supabase@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "read_text_file",
      "write_file",
      "edit_file"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-doc-location.sh\""
          }
        ]
      }
    ]
  }
}
