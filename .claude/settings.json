{
  "permissions": {
    "allow": [
      "mcp__fetch__fetch"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint --silent 1>&2 || exit 2"
          }
        ]
      }
    ]
  }
}
