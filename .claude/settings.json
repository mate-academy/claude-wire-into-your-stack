{
  "permissions": {
    "deny": [
      "mcp__filesystem__write_file"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint -- --max-warnings 0"
          }
        ]
      }
    ]
  }
}
