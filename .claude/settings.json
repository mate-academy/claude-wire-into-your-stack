{
  "enabledMcpjsonServers": ["docs"],
  "permissions": {
    "allow": [
      "mcp__docs__read_text_file",
      "mcp__docs__list_directory",
      "mcp__docs__search_files"
    ],
    "deny": [
      "mcp__docs__write_file",
      "mcp__docs__edit_file",
      "mcp__docs__create_directory",
      "mcp__docs__move_file"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/lint-after-edit.js"
          }
        ]
      }
    ]
  }
}
