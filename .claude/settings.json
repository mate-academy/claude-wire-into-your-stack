{
  "permissions": {
    "allow": [
      "mcp__docsfs__read_text_file",
      "mcp__docsfs__list_directory",
      "mcp__docsfs__search_files"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-force-push.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
