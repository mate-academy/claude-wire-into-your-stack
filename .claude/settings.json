{
  "permissions": {
    "allow": [
      "mcp__docs__read_file",
      "mcp__docs__list_directory",
      "mcp__docs__directory_tree",
      "mcp__docs__get_file_info",
      "mcp__docs__search_files"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npm run lint"
          }
        ]
      }
    ]
  }
}
