{
  "permissions": {
    "allow": [
      "mcp__filesystem__read_text_file",
      "mcp__filesystem__list_directory",
      "mcp__filesystem__search_files",
      "mcp__filesystem__get_file_info"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "npm run lint || { echo 'Lint failed - fix errors before committing.' >&2; exit 2; }",
            "timeout": 60,
            "statusMessage": "Linting before commit..."
          }
        ]
      }
    ]
  }
}
