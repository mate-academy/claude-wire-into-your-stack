{
  "mcpServers": {
    "project-docs": {
      "command": "node",
      "args": [".claude/mcp-server.js"],
      "env": {
        "PROJECT_ROOT": "${PROJECT_ROOT}"
      },
      "disabled": false,
      "alwaysAllow": []
    }
  },
  "permissionRules": [
    {
      "resource": "project-docs",
      "allow": ["tools/read_file", "tools/list_routes"],
      "description": "Allow reading project documentation and listing API routes"
    }
  ]
}
