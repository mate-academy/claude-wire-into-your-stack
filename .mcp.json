{
  "mcpServers": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "env": {},
      "permissions": {
        "allow": ["mcp__filesystem__read_file", "mcp__filesystem__read_multiple_files"],
        "deny": ["mcp__filesystem__delete_file"]
      }
    }
  }
}
